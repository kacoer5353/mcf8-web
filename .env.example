# PostgreSQL Database Connection Details (fill with your Render.com values)
# Hostname (internal/private):
DB_HOST=
# Port (usually 5432):
DB_PORT=
# Database name:
DB_NAME=
# Username:
DB_USER=
# Password:
DB_PASS=

# External connection URL (Render offers a DATABASE_URL you can paste here):
# Example: postgres://user:password@external-host:5432/dbname?sslmode=require
DATABASE_URL=

# Internal Database URL (if Render provides an internal/private URL for services in same region):
# INTERNAL_DATABASE_URL=postgres://user:password@internal-host:5432/dbname?sslmode=require

# SSL mode for libpq: disable, allow, prefer, require, verify-ca, verify-full
DB_SSLMODE=require

# Handy psql connection string (example) — paste into a terminal that has psql installed:
# psql "host=your_render_external_host port=5432 dbname=your_db_name_here user=your_db_user_here password=your_db_password_here sslmode=require"
PSQL_CONNECTION=

# Minecraft Server Info
MC_SERVER_IP=
MC_SERVER_PORT=

DISCORD_URL=
GITHUB_URL=
